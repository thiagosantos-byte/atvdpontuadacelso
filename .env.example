# Ambiente
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Gere um segredo privado com:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=SUBSTITUA_POR_VALOR_ALEATORIO_COM_48_BYTES
SESSION_TTL_MS=28800000

# Banco SQLite persistente (a pasta data e criada automaticamente)
DATABASE_PATH=./data/senai-google-identity.sqlite

# Use o MESMO Client ID nos dois campos.
# VITE_GOOGLE_CLIENT_ID e publico e incorporado ao build do frontend.
# GOOGLE_CLIENT_ID e lido exclusivamente pelo backend para validar o aud do ID token.
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
