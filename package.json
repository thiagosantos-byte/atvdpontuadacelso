{
  "name": "senai-google-identity-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma educacional SENAI sobre Google Identity Services, OAuth 2.0 e autenticação segura.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "check": "node --check server/index.js && node --check server/auth/google.js && node --check server/routes/auth.routes.js && vite build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4"
  }
}
